# ============================================================
# Luxra Beauty 主站前端 —— 环境变量示例
# ------------------------------------------------------------
# 本文件【可以】提交到版本库，只包含占位值，禁止填写任何真实凭据。
# 真实值请复制本文件为 .env 或 .env.local 后填写（这两个文件已被 .gitignore 排除）。
#
# 只有 VITE_ 前缀的变量会被注入到浏览器端代码中 ——
# 因此【绝对不要】在这里放任何密钥、令牌或私有凭据。
# ============================================================

# 后端 API 源（不含 /api/v1 前缀）
# 本地后端默认监听 4000 端口（见 luxra-beauty-backend/.env.example）。
# 注意：主机名用 127.0.0.1 而不是 localhost，与后端开发库的连接约定保持一致。
VITE_API_BASE_URL="http://127.0.0.1:4000"

# 是否使用演示（Mock）数据。
#   true  = 使用明确标记的模拟数据（界面会显示「演示数据」角标）
#   false = 调用真实后端 API（需要后端已启动，且已配置 CORS）
#
# ⚠️ 缺省方向是「真实 API」：**只有显式写 true 才进入演示模式**。
#    未设置、写错、或构建机没有 .env 时，一律走真实 API ——
#    连不上后端会如实报错，而不是静默渲染出并不存在的演示商品。
#    当前项目已进入前后端联调阶段，故此处示例值为 false。
VITE_USE_MOCK="false"

# ⚠️ 当前代码**未读取**此变量：浏览器标签标题取自 src/config/brand.ts 的
#    brandName（见 App.vue）。保留仅为兼容原项目配置，修改它不会影响界面。
VITE_APP_TITLE="Luxra Beauty"

# 开发服务器端口（默认 5173）。仅在 5173 已被其它项目占用时修改。
# ⚠️ 改端口后必须把新来源加入后端 CORS_ALLOWED_ORIGINS，否则接口会被 CORS 拦截。
# VITE_DEV_PORT=5175

# 【仅本地联调 / 测试用】结算页「测试：打开 WhatsApp」按钮的目标号码。
# 纯数字国际格式（含国家代码、不含 + 与空格），例如 8613070758373。
#
# ⚠️ 公开目录刻意不下发客服号码（隐私不变量），所以测试按钮的号码只能来自这里。
# ⚠️ 未配置时该按钮**不渲染** —— 生产构建请勿配置，避免暴露测试入口。
# VITE_WHATSAPP_TEST_NUMBER="8613070758373"
